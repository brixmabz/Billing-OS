# Database Provider: "postgres" or "supabase"
DATABASE_PROVIDER=supabase

# DB URL
DATABASE_URL=

# Supabase (required when using supabase provider)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# JWT Authentication
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Slack Integration
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
SLACK_ENABLED=false

# Resend Email
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
EMAIL_ENABLED=false

# Client Portal
PORTAL_BASE_URL=http://localhost:5173/portal
PORTAL_TOKEN_EXPIRY_HOURS=72

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# Debug
DEBUG=true
